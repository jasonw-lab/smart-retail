        <mxCell id="flow-1" value="1. 管理者がWeb UIで店舗・在庫・売上・アラートを確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2E86C1;fontSize=12;fontColor=#17202A;" vertex="1" parent="1">
