# Backend API URL (Server-side only)
BACKEND_URL=http://localhost:8091/api/v1

# Public environment variables (exposed to browser)
NEXT_PUBLIC_WS_ENDPOINT=ws://localhost:8091/ws

# Mock API mode (for E2E testing without backend)
# Set to "true" to enable mock mode
NEXT_PUBLIC_MOCK_API=false

# Redis URL for production ticket store (optional)
# REDIS_URL=redis://localhost:6379
