# Database
MYSQL_ROOT_PASSWORD=your_mysql_password

# Nacos
NACOS_MYSQL_PASSWORD=your_nacos_password

# Redis
REDIS_PASSWORD=your_redis_password

# MinIO
MINIO_ROOT_USER=your_minio_username
MINIO_ROOT_PASSWORD=your_minio_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=your_rabbitmq_username
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# XXL-Job-Admin
XXL_JOB_MYSQL_PASSWORD=your_xxl_job_password

# Remote Deployment (Mac -> Ubuntu)
SERVER_IP=<Ubuntu の IP>
SSH_USER=<SSH ユーザー名>
SSH_PASSWORD=<SSH パスワード>
# (optional) 使用する SSH 秘密鍵のパス。未指定時は ~/.ssh/id_ed25519
# SSH_KEY_PATH=~/.ssh/id_ed25519

# Application / Deploy (optional - defaults are set in docker-compose-app.yml)
# BASEPATH=/mydata
# DATASOURCE_PASSWORD=123456
# MYSQL_HOST=smart-retail-mysql-8
# MYSQL_DATABASE=smart_dx_db
# SPRING_DATA_REDIS_HOST=ec-demo-redis
# REDIS_PASSWORD=123456
# MINIO_ENDPOINT=http://ec-demo-minio:9000
# POWERJOB_SERVER_ADDRESS=smart-retail-powerjob-server:7700