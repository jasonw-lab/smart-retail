        </mxCell>
        <mxCell id="flow-4" value="4. Scheduler / Simulator が在庫・期限・通信・決済イベントを発生させ、アラートを自動生成する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=12;fontColor=#17202A;" vertex="1" parent="1">
